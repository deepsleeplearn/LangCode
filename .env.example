LANGCODE_PROVIDER=openai
LANGCODE_OPENAI_GATEWAY=aimp-glm
LANGCODE_MODEL=glm-5

# AIMP GLM-5. Set LANGCODE_PROVIDER=openai,
# LANGCODE_OPENAI_GATEWAY=aimp-glm, and LANGCODE_MODEL=glm-5 to use it.
# LANGCODE_THINKING controls chat_template_kwargs.thinking; GLM defaults to thinking enabled.
AIMP_GLM_BASE_URL=https://aimpapi.midea.com/t-aigc/aimp-glm/v1
AIMP_GLM_USER=guojian34
AIMP_GLM_API_KEY=
LANGCODE_THINKING=true

# AIMP Kimi K3. Set LANGCODE_PROVIDER=openai,
# LANGCODE_OPENAI_GATEWAY=aimp-kimi-k3, and LANGCODE_MODEL=kimi-k3 to use it.
AIMP_KIMI_K3_BASE_URL=https://aimpapi.midea.com/t-aigc/mip-chat-app/openai/v1
AIMP_KIMI_K3_USER=
AIMP_KIMI_K3_API_KEY=

# AIMP Qwen3.8 Max. Set LANGCODE_PROVIDER=openai,
# LANGCODE_OPENAI_GATEWAY=aimp-qwen3.8-max, and LANGCODE_MODEL=qwen3.8-max to use it.
AIMP_QWEN3_8_MAX_BASE_URL=https://aimpapi.midea.com/t-aigc/mip-chat-app/openai/v1
AIMP_QWEN3_8_MAX_USER=
AIMP_QWEN3_8_MAX_API_KEY=

# AIMP DeepSeek-V4 Pro. Set LANGCODE_PROVIDER=openai,
# LANGCODE_OPENAI_GATEWAY=aimp-deepseek-v4-pro, and LANGCODE_MODEL=deepseek-v4-pro to use it.
# LANGCODE_THINKING=true enables the model thinking mode.
AIMP_DEEPSEEK_V4_BASE_URL=https://aimpapi.midea.com/t-aigc/aimp-deepseek-v4-pro/v1
AIMP_DEEPSEEK_V4_USER=
AIMP_DEEPSEEK_V4_API_KEY=

# ASR. auto 会优先选择可用 CUDA，其次 Apple MPS，最后 CPU；Mac 本机可显式设置为 mps。
# 默认可由 Transformers 自动下载；如需固定到项目本地，可运行 scripts/download_asr_model.py。
LANGCODE_ASR_DEVICE=auto
LANGCODE_ASR_DTYPE=auto
LANGCODE_ASR_MODEL_REPO=Qwen/Qwen3-ASR-0.6B
LANGCODE_ASR_MODEL_DIR=

# TTS. 默认音色使用 macOS say；自定义音色优先使用本地 MLX/CosyVoice3。
# MLX 模型体积较大，不提交到 Git。要启用自定义音色，可运行 scripts/download_tts_model.py 放到默认目录：
#   .langcode/tts-models/Fun-CosyVoice3-0.5B-2512-8bit
# 或设置 LANGCODE_TTS_MODEL_DIR 指向已有模型目录。
# 也可以配置 LANGCODE_TTS_BASE_URL 使用远程 TTS；本地和远程不可用时会回退到 macOS say。
LANGCODE_TTS_PROVIDER=auto
LANGCODE_TTS_MODEL_REPO=mlx-community/Fun-CosyVoice3-0.5B-2512-8bit
LANGCODE_TTS_MODEL_DIR=
LANGCODE_TTS_VOICE_DIR=
LANGCODE_TTS_WORKERS=1
LANGCODE_TTS_BASE_URL=
LANGCODE_TTS_SAY_VOICE=Tingting
# Optional local directory containing custom wav voice samples.
LANGCODE_TTS_SAMPLE_DIR=

# Web search/fetch. Tavily basic search costs 1 credit per request.
LANGCODE_WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
